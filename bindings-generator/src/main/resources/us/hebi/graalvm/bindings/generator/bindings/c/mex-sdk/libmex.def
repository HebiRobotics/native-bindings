; Import library definition for the MEX API subset used by the generated MEX
; gateway. Export symbol names are interface facts of MATLAB's libmex.dll, the
; _800 suffix selects the R2018a interleaved-complex API.
LIBRARY libmex
EXPORTS
    mexAtExit_800
    mexCallMATLAB_800
    mexCallMATLABWithTrap_800
    mexErrMsgIdAndTxt_800
    mexErrMsgTxt_800
    mexMakeArrayPersistent_800
    mexWarnMsgIdAndTxt_800
