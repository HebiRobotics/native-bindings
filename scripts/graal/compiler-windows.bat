@echo off
setlocal EnableDelayedExpansion

REM This script intercepts compiler arguments generated by GraalVM's native-image for
REM creating a shared library, and generates both shared and static libraries. Tested on
REM GraalVM jdk22.0.1+8.1 on Windows 10 and may need to be modified for other versions.
REM
REM Use with --native-compiler-path=${pathToThisScript}.bat

REM Determine the project name and output path based on the /Fe output dll argument
REM In some cases (e.g. JavaFX) it also generates additional dlls that should be ignored.
set OUTPUT_PATH=
set LIB_NAME=
set EXCLUDE_LIB=("java" "jvm")

for %%P in (%*) do (
    echo %%P | findstr /C:"\.dll" 1>nul
    if !errorlevel!==0 (
        set OUTPUT_PATH=%%~pP
        set OUTPUT_PATH=!OUTPUT_PATH:\Fe=!
        set LIB_NAME=%%~nP

        for %%E in %EXCLUDE_LIB% do (
                    if "!LIB_NAME!"=="%%~E" (
                        set LIB_NAME=
                        break
                    )
                )
    )
)

REM Do a simple forward for any calls that are used to compile individual C files
IF "%LIB_NAME%"=="" (
    cl.exe %*
    exit /b !errorlevel!
)

REM Setup log path and log file
set LOG_PATH=%OUTPUT_PATH%\reports
set LOG_FILE=%LOG_PATH%\compiler_commands.txt
if not exist %LOG_PATH% mkdir %LOG_PATH%

echo ===================================================== > %LOG_FILE%
echo Working directory: %CD% >> %LOG_FILE%
echo Output path: %OUTPUT_PATH% >> %LOG_FILE%
echo Library name: %LIB_NAME% >> %LOG_FILE%

echo ===================================================== >> %LOG_FILE%
echo                   SHARED LIBRARY                      >> %LOG_FILE%
echo ===================================================== >> %LOG_FILE%
REM Always create the standard shared library so we don't break
REM native-image assumptions about generated files
set CL_ARGS=%*
echo cl.exe %CL_ARGS% >> %LOG_FILE%
cl.exe %CL_ARGS%
if !errorlevel! neq 0 exit /b !errorlevel!

echo ===================================================== >> %LOG_FILE%
echo                   STATIC LIBRARY                      >> %LOG_FILE%
echo ===================================================== >> %LOG_FILE%
REM To avoid naming collisions, we create a separate directory for
REM static libraries and dependencies. We also create a cmake file
REM that specifies the required options.
set STATIC_OUTPUT_PATH=%OUTPUT_PATH%\static
if not exist %STATIC_OUTPUT_PATH% mkdir %STATIC_OUTPUT_PATH%

REM Build a .cmake file with all dependencies
echo Preparing library dependencies >> %LOG_FILE%
set CMAKE_LIBS=%STATIC_OUTPUT_PATH%\libs.cmake
echo set(GRAALVM_LIBS > %CMAKE_LIBS%

REM Create an archive of the original obj file via "lib.exe input.obj /OUT:output.lib"
set LIB_ARGS="%LIB_NAME%.obj" /OUT:"%STATIC_OUTPUT_PATH%\%LIB_NAME%.lib"
echo * lib.exe %LIB_ARGS% >> %LOG_FILE%
lib.exe %LIB_ARGS%
if !errorlevel! neq 0 exit /b !errorlevel!
echo     ${CMAKE_CURRENT_LIST_DIR}/%LIB_NAME%.lib >> %CMAKE_LIBS%

REM Add the required static and OS dependencies
for %%i in (%*) do (
    if /i "%%~xi"==".lib" (
        if exist %%i ( REM GraalVM static libs
            echo * copy "%%i" %STATIC_OUTPUT_PATH% >> %LOG_FILE%
            copy "%%i" %STATIC_OUTPUT_PATH%
            echo     ${CMAKE_CURRENT_LIST_DIR}/%%~nxi  # %%i >> %CMAKE_LIBS%
        ) else ( REM OS static libs
            REM The /IMPLIB flag is only used for shared libraries, so
            REM we need to filter those inputs. Bash does not have a
            REM startsWith comparison, so we strip "/IMPLIB" and check
            REM whether that changes the argument.
            set "arg=%%i"
            set "stripImplib=!arg:/IMPLIB=!"
            if not "!stripImplib!"=="!arg!" (
                echo * Skipped: %%i >> %LOG_FILE%
            ) else (
                echo * Added os lib: %%i >> %LOG_FILE%
                echo     %%i >> %CMAKE_LIBS%
            )
        )
    )
)

REM finish cmake file
echo ) >> %CMAKE_LIBS%

REM add the used linker options
echo Preparing linker arguments >> %LOG_FILE%
set CMAKE_OPTS=%STATIC_OUTPUT_PATH%\opts.cmake
echo set(GRAALVM_OPTS > %CMAKE_OPTS%

set "LINK_SECTION=0"
for %%i in (%*) do (
    set "arg=%%i"
    set /a "IS_LINKER_OPT=!LINK_SECTION!"

    REM Check if we hit the /link marker
    if "!arg!"=="/link" (
        echo * Found linker section >> %LOG_FILE%
        set "LINK_SECTION=1"
    )

    REM Libs are already handled above
    if /i "%%~xi"==".lib" (
        set "IS_LINKER_OPT=0"
    )

   REM Skip /LIBPATH (handled by CMake)
   echo !arg! | findstr /C:"/LIBPATH" >nul
   if !errorlevel! equ 0 (
       echo * Skipped: %%i >> %LOG_FILE%
       set "IS_LINKER_OPT=0"
   )

  REM Skip /export
  echo !arg! | findstr /C:"/export" >nul
  if !errorlevel! equ 0 (
      echo * Skipped: %%i >> %LOG_FILE%
      set "IS_LINKER_OPT=0"
  )

    REM Valid option
    if !IS_LINKER_OPT! equ 1 (

        REM Add linker options
        echo * Added linker option: "%%i" >> %LOG_FILE%
        echo     "%%i" >> %CMAKE_OPTS%

    )

)

echo ) >> %CMAKE_OPTS%
